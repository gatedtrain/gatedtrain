# NeMo RL trainer image for a trainer running as uid 1000: the Tier B image plus the ten vLLM files NeMo RL patches at
# start-up (nemo_rl/models/generation/vllm/patches.py, _apply_vllm_patches), and their eight directories, owned by uid
# 1000. NeMo RL rewrites those files and creates `<file>.patch_lock` beside them in the VllmGenerationWorker venv, which
# belongs to nemo-runtime (uid 65532); the trainer runs as 1000:1000 (MM-34 refuses root), so without this layer the
# first GRPO smoke fails with PermissionError on ray_executor.py.patch_lock. Nothing is added or upgraded.
# Build (see README.md): docker [--context <context>] build --build-arg BASE=<the Tier B image> -t <tag> <this directory>
# BASE is required: it names the Tier B image on that daemon. The image IDs gatedtrain accepts are data, in the image
# lock (`gatedtrain image list`); `gatedtrain image check nemo-rl/tierb-uid1000 --ref <tag>` checks a build.
# The final `USER root` is kept on purpose: it is part of the image configuration behind the accepted image ID, and the
# launcher always runs the container with an explicit `--user` (1000:1000), so the image's default user is not used.
ARG BASE
FROM ${BASE}
USER root
RUN set -eu; \
    V=/opt/ray_venvs/nemo_rl.models.generation.vllm.vllm_worker.VllmGenerationWorker/lib/python3.13/site-packages/vllm; \
    for f in distributed/device_communicators/shm_broadcast.py \
             model_executor/layers/fused_moe/routed_experts_capturer.py \
             model_executor/layers/fused_moe/runner/moe_runner.py \
             model_executor/models/deepseek_v2.py \
             model_executor/models/llama_eagle3.py \
             model_executor/models/nano_nemotron_vl.py \
             model_executor/models/radio.py \
             tool_parsers/utils.py \
             v1/executor/ray_executor.py \
             v1/executor/ray_executor_v2.py; do \
      test -f "$V/$f"; chown 1000:1000 "$V/$f" "$(dirname "$V/$f")"; \
    done
USER root
